{
  "name": "@formulon-cell/vue-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "../../node_modules/.bin/playwright test",
    "test:e2e:visual": "FC_VISUAL=1 ../../node_modules/.bin/playwright test e2e/visual/excel-chrome.visual.spec.ts --project=chromium",
    "test:e2e:visual:update": "FC_VISUAL=1 ../../node_modules/.bin/playwright test e2e/visual/excel-chrome.visual.spec.ts --project=chromium --update-snapshots",
    "test:e2e:ui": "../../node_modules/.bin/playwright test --ui",
    "test:e2e:install": "../../node_modules/.bin/playwright install --with-deps chromium webkit"
  },
  "dependencies": {
    "@libraz/formulon-cell": "workspace:*",
    "@libraz/formulon-cell-vue": "workspace:*",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vue-tsc": "^3.3.10"
  }
}
