{
  "name": "@libraz/formulon-cell",
  "version": "0.15.0",
  "description": "Excel-like spreadsheet component for the browser: canvas grid, formula bar, ribbon and sheet tabs, calculated by the Formulon WASM engine.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "libraz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/formulon-cell.git",
    "directory": "packages/formulon-cell"
  },
  "homepage": "https://formulon.libraz.net/cell/",
  "bugs": "https://github.com/libraz/formulon-cell/issues",
  "keywords": [
    "spreadsheet",
    "workbook",
    "xlsx",
    "formula",
    "canvas",
    "headless-ui",
    "datagrid",
    "wasm",
    "i18n",
    "excel",
    "excel-like",
    "spreadsheet-component",
    "webassembly",
    "formulon"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar/index.d.ts",
      "import": "./dist/toolbar/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js"
    },
    "./i18n/*": {
      "types": "./dist/i18n/locales/*.d.ts",
      "import": "./dist/i18n/locales/*.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./styles/paper.css": "./dist/styles/theme-paper.css",
    "./styles/ink.css": "./dist/styles/theme-ink.css",
    "./styles/contrast.css": "./dist/styles/theme-contrast.css",
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./styles/toolbar.css": "./dist/styles/toolbar.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@libraz/formulon": "0.19.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@libraz/gridsmith": "github:libraz/gridsmith#commit=9a8978a31ee8b48a3ad5b611fea2479c478f9604",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
