{
  "name": "@libraz/formulon-cell-react",
  "version": "0.15.1",
  "description": "Excel-like spreadsheet component for React 18+: component and hooks for @libraz/formulon-cell.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "libraz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/formulon-cell.git",
    "directory": "packages/formulon-cell-react"
  },
  "homepage": "https://formulon.libraz.net/cell/",
  "bugs": "https://github.com/libraz/formulon-cell/issues",
  "keywords": [
    "spreadsheet",
    "react",
    "workbook",
    "datagrid",
    "formulon-cell",
    "excel",
    "excel-like",
    "react-component",
    "xlsx",
    "formula"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@libraz/formulon-cell": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^9",
    "typescript": "6.0.3"
  }
}
